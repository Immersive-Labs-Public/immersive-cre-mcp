# Immersive Labs platform login used to obtain a CRE session (no API tokens exist).
IMMERSIVE_CRE_USERNAME=
IMMERSIVE_CRE_PASSWORD=
# eu (immersivelabs.online) or us (us.immersivelabs.com); sets all the hosts below.
IMMERSIVE_CRE_REGION=eu
# Per-host overrides (default from the region):
# IMMERSIVE_CRE_BASE_URL=https://api4.eu.snaplabs.io
# IMMERSIVE_CRE_DASHBOARD_URL=https://dashboard.immersivelabs.eu.snaplabs.io
# IMMERSIVE_CRE_IL_URL=https://immersivelabs.online
# IMMERSIVE_CRE_IL_API_URL=https://api.immersivelabs.online
# IMMERSIVE_CRE_HYDRA_URL=https://hydra.immersivelabs.online
# IMMERSIVE_CRE_HYDRA_CLIENT_ID=

# IMMERSIVE_CRE_TOKEN_CACHE=~/.cache/immersive-cre-mcp/token   # empty = keep the session in memory only
# IMMERSIVE_CRE_READ_ONLY=false
# IMMERSIVE_CRE_ENABLE_RAW=true
